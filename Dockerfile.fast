FROM node:22-alpine
WORKDIR /app
COPY package*.json ./
RUN npm ci --only=production --ignore-scripts || npm install --omit=dev

# Copy source needed for runtime (not full build)
COPY public ./public
COPY src ./src
COPY .next ./.next
COPY next.config.ts ./
COPY package.json ./
COPY tailwind.config.ts ./
COPY postcss.config.js ./
COPY tsconfig.json ./

EXPOSE 3000
CMD ["npm","run","start"]
